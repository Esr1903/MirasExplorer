# Frontend: public base URL of the FastAPI deployment. Leave unset for the
# local default (http://127.0.0.1:8000).
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Backend (set these in the backend runtime, never commit real values).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
# Comma-separated exact frontend origins allowed to call the API.
CORS_ORIGINS=https://app.example.com
