# Frontend: public base URL of the FastAPI deployment. Use the Render URL in
# production; leave it unset locally to use http://127.0.0.1:8000.
NEXT_PUBLIC_API_BASE_URL=https://mirasexplorer.onrender.com

# Backend (set these in the backend runtime, never commit real values).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
# Comma-separated exact frontend origins allowed to call the API.
CORS_ORIGINS=https://miras-explorer.vercel.app,http://localhost:3000,http://127.0.0.1:3000
